<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Domain VPN"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#32CD32"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter websites. VPN auto-enables when you visit them."
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etDomain"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="e.g. youtube.com"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:background="@drawable/domain_input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="16sp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:text="Add"
            android:textColor="#0D0D0D"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#32CD32"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDomains"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Save"
        android:textColor="#0D0D0D"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="#32CD32"
        android:layout_marginTop="16dp" />

</LinearLayout>
