<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="СКАНИРОВАТЬ QR-КОД"
            android:textColor="#0D0D0D"
            android:textStyle="bold"
            android:backgroundTint="#32CD32"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Или введите вручную:"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Endpoint (host:port)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPrivateKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Private Key"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPublicKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Public Key"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address (например 192.168.6.54/32)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="DNS (1.1.1.1, 8.8.8.8)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPresharedKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preshared Key (опционально)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etAllowedIPs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AllowedIPs (0.0.0.0/0)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPersistentKeepalive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PersistentKeepalive (25)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/domain_input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AmneziaWG параметры (опционально):"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etJc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Jc"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etJmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Jmin"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etJmax"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Jmax"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etS1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="S1"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etS2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="S2"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etH1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="H1"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etH2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="H2"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etH3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="H3"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etH4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="H4"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/domain_input_bg"
                android:padding="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>